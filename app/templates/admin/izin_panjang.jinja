{% if not is_htmx %}
    {% extends "admin/layout.jinja" %}
    {% block title %}Data Izin Panjang{% endblock %}
{% else %}
    <title>Data Izin Panjang</title>
{% endif %}

{% from 'macros.jinja' import render_notif %}

{% block content %}

{{ render_notif(error, success, info) }}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0">Data Izin Panjang</h4>
</div>

<div class="form-text mb-3">
    <i class="bi bi-info-circle"></i>
    Pemberian izin panjang dilakukan dari halaman
    <a href="{{ url_for('admin.siswa') }}"
       hx-get="{{ url_for('admin.siswa') }}"
       hx-target="#hx_content" hx-swap="innerHTML">Siswa</a>
    &mdash; buka detail siswa lalu gunakan tombol "Tambah Izin Panjang".
    Tombol aksi hanya tampil untuk superadmin dan pembuat izin.
</div>

<div class="table-responsive">
    <table id="izinPanjangTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>Nama</th>
                <th>Rombel</th>
                <th>Tanggal Mulai</th>
                <th>Tanggal Selesai</th>
                <th>Kategori</th>
                <th>Dibuat Oleh</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="modal fade" id="modalHapusIzinPanjang" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Konfirmasi Hapus Izin Panjang</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                Hapus izin panjang untuk <strong id="modalHapusIzinPanjangNama"></strong>
                (<span id="modalHapusIzinPanjangTanggal"></span>)?
                <div class="form-text mt-2">
                    Permintaan peminjaman untuk hari ini dan seterusnya tidak akan
                    dibuat lagi. Riwayat hari-hari sebelumnya tetap tersimpan.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <form id="modalHapusIzinPanjangForm"
                      hx-post="{{ url_for('admin.izin_panjang_hapus') }}"
                      style="display:inline"
                      onsubmit="tutup_modal_izin_panjang()">
                    <input type="hidden" name="id" id="modalHapusIzinPanjangId" value=""/>
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
                    <button type="submit" class="btn btn-danger">Hapus</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
var hapus_izin_panjang = (id, nama, mulai, selesai) => {
    document.getElementById('modalHapusIzinPanjangId').value = id;
    document.getElementById('modalHapusIzinPanjangNama').textContent = nama;
    document.getElementById('modalHapusIzinPanjangTanggal').textContent = mulai + ' - ' + selesai;
    new bootstrap.Modal(document.getElementById('modalHapusIzinPanjang')).show();
};
var tutup_modal_izin_panjang = () => {
    bootstrap.Modal.getInstance(document.getElementById('modalHapusIzinPanjang')).hide();
};
var edit_izin_panjang = (id) => {
    var raw_url = "{{ url_for('admin.izin_panjang_edit', period_id=0) }}";
    var url = raw_url.slice(0, -1) + String(id);
    htmx.ajax("GET", url, {target:'#hx_content', swap:'innerHTML'});
};
(function() {
    if ($.fn.DataTable.isDataTable('#izinPanjangTable')) {
        $('#izinPanjangTable').DataTable().destroy();
        $('#izinPanjangTable').empty();
    }
    $('#izinPanjangTable').DataTable({
        ajax: {
            url: '{{ url_for("admin.izin_panjang_data") }}',
            dataSrc: 'data'
        },
        columns: [
            { data: 'no' },
            { data: 'name' },
            { data: 'class_group' },
            { data: 'start_date' },
            { data: 'end_date' },
            { data: 'category' },
            { data: 'creator' },
            { data: 'status', orderable: false },
            { data: 'actions', orderable: false, searchable: false }
        ],
        language: {
            search: 'Cari:',
            lengthMenu: 'Tampilkan _MENU_ data',
            info: 'Menampilkan _START_ - _END_ dari _TOTAL_ data',
            infoEmpty: 'Belum ada data izin panjang',
            emptyTable: 'Belum ada data izin panjang',
            zeroRecords: 'Tidak ditemukan data yang cocok',
            paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' }
        }
    });
})();
</script>

{% endblock %}
