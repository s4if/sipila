{% if not is_htmx %}
    {% extends "admin/layout.jinja" %}
    {% block title %}Data Larangan{% endblock %}
{% else %}
    <title>Data Larangan</title>
{% endif %}

{% from 'macros.jinja' import render_notif %}

{% block content %}

{{ render_notif(error, success, info) }}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0">Data Larangan Peminjaman</h4>
    <a class="btn btn-primary"
       href="{{ url_for('admin.larangan_tambah') }}"
       hx-get="{{ url_for('admin.larangan_tambah') }}"
       hx-target="#hx_content"
       hx-swap="innerHTML">
        <i class="bi bi-plus-lg"></i> Tambah Larangan
    </a>
</div>

<div class="table-responsive">
    <table id="laranganTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>NIS</th>
                <th>Nama</th>
                <th>Rombel</th>
                <th>Tanggal Mulai</th>
                <th>Tanggal Selesai</th>
                <th>Alasan</th>
                <th>Dibuat Oleh</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="modal fade" id="modalHapusLarangan" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Konfirmasi Hapus Larangan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                Hapus larangan untuk <strong id="modalHapusLaranganNama"></strong>
                (<span id="modalHapusLaranganTanggal"></span>)?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <form id="modalHapusLaranganForm"
                      hx-post="{{ url_for('admin.larangan_hapus') }}"
                      style="display:inline"
                      onsubmit="tutup_modal_larangan()">
                    <input type="hidden" name="id" id="modalHapusLaranganId" value=""/>
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
                    <button type="submit" class="btn btn-danger">Hapus</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
var hapus_larangan = (id, nama, mulai, selesai) => {
    document.getElementById('modalHapusLaranganId').value = id;
    document.getElementById('modalHapusLaranganNama').textContent = nama;
    document.getElementById('modalHapusLaranganTanggal').textContent = mulai + ' - ' + selesai;
    new bootstrap.Modal(document.getElementById('modalHapusLarangan')).show();
};
var tutup_modal_larangan = () => {
    bootstrap.Modal.getInstance(document.getElementById('modalHapusLarangan')).hide();
};
var edit_larangan = (id) => {
    var raw_url = "{{ url_for('admin.larangan_edit', ban_id=0) }}";
    var url = raw_url.slice(0, -1) + String(id);
    htmx.ajax("GET", url, {target:'#hx_content', swap:'innerHTML'});
};
(function() {
    if ($.fn.DataTable.isDataTable('#laranganTable')) {
        $('#laranganTable').DataTable().destroy();
        $('#laranganTable').empty();
    }
    $('#laranganTable').DataTable({
        ajax: {
            url: '{{ url_for("admin.larangan_data") }}',
            dataSrc: 'data'
        },
        columns: [
            { data: 'no' },
            { data: 'nis' },
            { data: 'name' },
            { data: 'class_group' },
            { data: 'start_date' },
            { data: 'end_date' },
            { data: 'reason' },
            { data: 'creator' },
            { data: 'status', orderable: false },
            { data: 'actions', orderable: false, searchable: false }
        ],
        language: {
            search: 'Cari:',
            lengthMenu: 'Tampilkan _MENU_ data',
            info: 'Menampilkan _START_ - _END_ dari _TOTAL_ data',
            infoEmpty: 'Belum ada data larangan',
            emptyTable: 'Belum ada data larangan',
            zeroRecords: 'Tidak ditemukan data yang cocok',
            paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' }
        }
    });
})();
</script>

{% endblock %}
