{% if not is_htmx %}
    {% extends "admin/layout.jinja" %}
    {% block title %}Detail Siswa{% endblock %}
{% else %}
    <title>Detail Siswa</title>
{% endif %}

{% from 'macros.jinja' import render_notif %}

{% block content %}

{{ render_notif(error, success, info) }}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0">Detail Siswa</h4>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary btn-sm"
           href="{{ url_for('admin.pinjaman_periode_tambah', id=student.id) }}"
           hx-get="{{ url_for('admin.pinjaman_periode_tambah', id=student.id) }}"
           hx-target="#hx_content"
           hx-swap="innerHTML">
            <i class="bi bi-calendar-week"></i> Tambah Pinjaman Periode
        </a>
        <a class="btn btn-secondary btn-sm"
           href="{{ url_for('admin.siswa') }}"
           hx-get="{{ url_for('admin.siswa') }}"
           hx-target="#hx_content"
           hx-swap="innerHTML">
            <i class="bi bi-arrow-left"></i> Kembali
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Informasi Siswa</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th class="ps-0" style="width:40%">NIS</th>
                        <td>{{ student.student_id }}</td>
                    </tr>
                    <tr>
                        <th class="ps-0">Nama</th>
                        <td>{{ student.name }}</td>
                    </tr>
                    <tr>
                        <th class="ps-0">Rombel</th>
                        <td>{{ student.class_group.display_name if student.class_group else '-' }}</td>
                    </tr>
                    {% if student.admin_note %}
                    <tr>
                        <th class="ps-0">Catatan Admin</th>
                        <td>{{ student.admin_note }}</td>
                    </tr>
                    {% endif %}
                    {% if has_active_ban %}
                    <tr>
                        <th class="ps-0">Status</th>
                        <td><span class="badge bg-danger">Sedang Dilrang</span></td>
                    </tr>
                    {% elif bans %}
                    <tr>
                        <th class="ps-0">Status</th>
                        <td><span class="badge bg-warning text-dark">Pernah Dilrang</span></td>
                    </tr>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Ringkasan Peminjaman</div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-6 col-md-3">
                        <div class="border rounded-3 py-3">
                            <div class="fs-4 fw-bold">{{ total_requests }}</div>
                            <div class="text-muted small">Total</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded-3 py-3">
                            <div class="fs-4 fw-bold text-warning">{{ pending_requests }}</div>
                            <div class="text-muted small">Pending</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded-3 py-3">
                            <div class="fs-4 fw-bold text-success">{{ accepted_requests }}</div>
                            <div class="text-muted small">Diterima</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded-3 py-3">
                            <div class="fs-4 fw-bold text-danger">{{ rejected_requests }}</div>
                            <div class="text-muted small">Ditolak</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3">Pinjaman Periode</h5>

<div class="table-responsive mb-4">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>Tanggal Mulai</th>
                <th>Tanggal Selesai</th>
                <th>Kategori</th>
                <th>Catatan</th>
                <th>Dibuat Oleh</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for period in loan_periods %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ period.start_date.strftime('%d/%m/%Y') }}</td>
                <td>{{ period.end_date.strftime('%d/%m/%Y') }}</td>
                <td>{{ period.category.name if period.category else '-' }}</td>
                <td>{{ period.note or '-' }}</td>
                <td>{{ period.creator.name or period.creator.username if period.creator else '-' }}</td>
                <td>
                    {% if period.status_label == 'active' %}
                    <span class="badge bg-success">Berlangsung</span>
                    {% elif period.status_label == 'upcoming' %}
                    <span class="badge bg-info">Mendatang</span>
                    {% elif period.status_label == 'concluded' %}
                    <span class="badge bg-secondary">Selesai</span>
                    {% else %}
                    <span class="badge bg-danger">Dibatalkan</span>
                    {% endif %}
                </td>
                <td>
                    {% if period.status_label in ('active', 'upcoming') %}
                    <form method="POST"
                          action="{{ url_for('admin.pinjaman_periode_batalkan', period_id=period.id) }}"
                          hx-post="{{ url_for('admin.pinjaman_periode_batalkan', period_id=period.id) }}"
                          hx-target="#hx_content"
                          hx-swap="innerHTML"
                          class="d-inline"
                          onsubmit="return confirm('Batalkan pinjaman periode ini? Permintaan untuk hari ini dan seterusnya tidak akan dibuat lagi.');">
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="bi bi-x-circle"></i> Batalkan
                        </button>
                    </form>
                    {% else %}
                    -
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8" class="text-muted text-center">Belum ada pinjaman periode</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<h5 class="mb-3">Riwayat Permintaan Peminjaman</h5>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="start_date" class="form-label">Dari Tanggal</label>
                <input type="date" id="start_date" class="form-control" value="{{ start_date }}"/>
            </div>
            <div class="col-md-3">
                <label for="end_date" class="form-label">Sampai Tanggal</label>
                <input type="date" id="end_date" class="form-control" value="{{ end_date }}"/>
            </div>
            <div class="col-md-auto">
                <button type="button" class="btn btn-primary" onclick="terapkan_filter()">
                    <i class="bi bi-funnel"></i> Terapkan
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="reset_filter()">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
                <button type="button" class="btn btn-success" onclick="export_excel()">
                    <i class="bi bi-file-earmark-excel"></i> Export Excel
                </button>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table id="riwayatTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>Tanggal</th>
                <th>Kategori</th>
                <th>Status</th>
                <th>Waktu Pengajuan</th>
                <th>Ditinjau Oleh</th>
                <th>Waktu Peninjauan</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
var build_data_url = function() {
    var base = "{{ url_for('admin.siswa_detail_data', id=student.id) }}";
    var params = new URLSearchParams();
    var sd = document.getElementById('start_date').value;
    var ed = document.getElementById('end_date').value;
    if (sd) params.append('start_date', sd);
    if (ed) params.append('end_date', ed);
    var qs = params.toString();
    return qs ? base + '?' + qs : base;
};

var build_export_url = function() {
    var base = "{{ url_for('admin.siswa_detail_export', id=student.id) }}";
    var params = new URLSearchParams();
    var sd = document.getElementById('start_date').value;
    var ed = document.getElementById('end_date').value;
    if (sd) params.append('start_date', sd);
    if (ed) params.append('end_date', ed);
    var qs = params.toString();
    return qs ? base + '?' + qs : base;
};

var riwayatTable;

var terapkan_filter = function() {
    riwayatTable.ajax.url(build_data_url()).load();
    window.history.replaceState(null, '', build_data_url());
};

var reset_filter = function() {
    document.getElementById('start_date').value = '';
    document.getElementById('end_date').value = '';
    terapkan_filter();
};

var export_excel = function() {
    window.location.href = build_export_url();
};

var detail_permintaan = function(id) {
    var raw_url = "{{ url_for('admin.permintaan_detail', id=0) }}";
    var url = raw_url.slice(0, -1) + String(id);
    htmx.ajax("GET", url, {target: '#hx_content', swap: 'innerHTML'});
};

(function() {
    if ($.fn.DataTable.isDataTable('#riwayatTable')) {
        $('#riwayatTable').DataTable().destroy();
        $('#riwayatTable').empty();
    }
    riwayatTable = $('#riwayatTable').DataTable({
        ajax: {
            url: build_data_url(),
            dataSrc: 'data'
        },
        columns: [
            { data: 'no' },
            { data: 'date' },
            { data: 'category' },
            { data: 'status' },
            { data: 'created_at' },
            { data: 'reviewer' },
            { data: 'reviewed_at' },
            { data: 'actions', orderable: false, searchable: false }
        ]
    });
})();
</script>

{% if bans %}
<h5 class="mb-3 mt-4">Riwayat Larangan</h5>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No</th>
                <th>Tanggal Mulai</th>
                <th>Tanggal Selesai</th>
                <th>Alasan</th>
                <th>Dibuat Oleh</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for ban in bans %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ ban.start_date.strftime('%d/%m/%Y') }}</td>
                <td>{{ ban.end_date.strftime('%d/%m/%Y') }}</td>
                <td>{{ ban.reason }}</td>
                <td>{{ ban.creator.name or ban.creator.username }}</td>
                <td>
                    {% if ban.is_active %}
                    <span class="badge bg-danger">Aktif</span>
                    {% elif ban.is_concluded %}
                    <span class="badge bg-secondary">Selesai</span>
                    {% else %}
                    <span class="badge bg-info">Mendatang</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<div class="form-text">
    <i class="bi bi-info-circle"></i>
    Pengelolaan larangan dilakukan di halaman
    <a href="{{ url_for('admin.larangan') }}"
       hx-get="{{ url_for('admin.larangan') }}"
       hx-target="#hx_content" hx-swap="innerHTML">Larangan</a>.
</div>
{% endif %}

{% endblock %}
