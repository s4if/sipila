<!doctype html>
<html lang="id">
<head>
    <title>{% block title %}{% endblock %}</title>
    <meta charset="UTF-8">
    <meta name="description" content="Sistem Peminjaman Laptop - SMKIT Ihsanul Fikri Mungkid">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style type="text/css">
        :root {
            --sipila-ink: #0f172a;
            --sipila-muted: #64748b;
            --sipila-line: #e2e8f0;
            --sipila-soft: #f1f5f9;
        }

        /* Tema Siswa — biru */
        .auth-theme-siswa {
            --sipila-accent: #3b82f6;
            --sipila-accent-2: #6366f1;
            --sipila-accent-shadow: rgba(59, 130, 246, 0.42);
            --sipila-accent-ring: rgba(59, 130, 246, 0.18);
        }

        /* Tema Admin — oranye/merah */
        .auth-theme-admin {
            --sipila-accent: #ef4444;
            --sipila-accent-2: #f97316;
            --sipila-accent-shadow: rgba(239, 68, 68, 0.42);
            --sipila-accent-ring: rgba(239, 68, 68, 0.20);
        }

        * { box-sizing: border-box; }

        html, body {
            height: 100%;
            margin: 0;
        }

        body.sipila-auth {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.25rem;
            background:
                radial-gradient(1100px 560px at 8% 6%, rgba(148, 163, 184, 0.14), transparent 60%),
                radial-gradient(1000px 520px at 95% 96%, rgba(100, 116, 139, 0.12), transparent 60%),
                linear-gradient(135deg, #0b1220 0%, #111c33 55%, #0b1220 100%);
            background-attachment: fixed;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body.sipila-auth.dimmed { filter: blur(3px); }

        .auth-wrap {
            width: 100%;
            max-width: 430px;
            animation: auth-rise 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @keyframes auth-rise {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .auth-card {
            background: #ffffff;
            border-radius: 1.25rem;
            box-shadow: 0 24px 60px rgba(2, 8, 23, 0.5), 0 2px 6px rgba(2, 8, 23, 0.2);
            padding: 2.1rem 2rem 1.6rem;
        }

        /* Brand */
        .auth-brand { text-align: center; margin-bottom: 1.35rem; }

        .auth-brand-badge {
            width: 62px;
            height: 62px;
            display: inline-grid;
            place-items: center;
            border-radius: 1rem;
            background: linear-gradient(135deg, var(--sipila-accent), var(--sipila-accent-2));
            color: #fff;
            font-size: 1.75rem;
            box-shadow: 0 12px 26px var(--sipila-accent-shadow);
            margin-bottom: 0.7rem;
        }

        .auth-brand h1 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0;
            color: var(--sipila-ink);
            letter-spacing: -0.01em;
        }

        .auth-brand p {
            margin: 0.2rem 0 0;
            color: var(--sipila-muted);
            font-size: 0.84rem;
        }

        /* Segmented role switch */
        .auth-role-toggle {
            display: flex;
            gap: 0.25rem;
            background: var(--sipila-soft);
            border-radius: 0.75rem;
            padding: 0.3rem;
            margin-bottom: 1.3rem;
        }

        .auth-role-toggle a {
            flex: 1 1 0;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--sipila-muted);
            padding: 0.5rem 0.5rem;
            border-radius: 0.55rem;
            transition: color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-role-toggle a i { margin-right: 0.3rem; }

        .auth-role-toggle a:hover { color: var(--sipila-ink); }

        .auth-role-toggle a.active {
            background: #fff;
            color: var(--sipila-ink);
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
        }

        .auth-role-toggle a.active i { color: var(--sipila-accent); }

        /* Form */
        .auth-heading {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--sipila-ink);
            margin: 0 0 1rem;
        }

        .auth-field { margin-bottom: 0.9rem; }

        .auth-field > label {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--sipila-muted);
            margin-bottom: 0.3rem;
            display: block;
        }

        .auth-input-group {
            display: flex;
            align-items: stretch;
            background: #fff;
            border: 1px solid var(--sipila-line);
            border-radius: 0.6rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-input-group:focus-within {
            border-color: var(--sipila-accent);
            box-shadow: 0 0 0 0.2rem var(--sipila-accent-ring);
        }

        .auth-input-group .input-group-text {
            background: transparent;
            border: 0;
            color: #94a3b8;
            padding: 0 0.85rem;
            display: flex;
            align-items: center;
            font-size: 1.05rem;
        }

        .auth-input-group .form-control {
            border: 0;
            box-shadow: none;
            padding: 0.7rem 0.25rem 0.7rem 0;
            height: auto;
            font-size: 0.95rem;
            color: var(--sipila-ink);
            background: transparent;
        }

        .auth-input-group .form-control::placeholder { color: #aeb8c4; }

        .auth-input-group .form-control:focus { box-shadow: none; }

        .auth-input-group .pw-toggle {
            border: 0;
            background: transparent;
            color: #94a3b8;
            padding: 0 0.9rem;
            font-size: 1.05rem;
            cursor: pointer;
        }

        .auth-input-group .pw-toggle:hover { color: var(--sipila-ink); }

        .auth-error-text {
            color: #dc2626;
            font-size: 0.8rem;
            margin-top: 0.3rem;
        }

        /* Captcha */
        .auth-captcha-row {
            display: flex;
            align-items: stretch;
            gap: 0.5rem;
        }

        .auth-captcha-row .auth-input-group { flex: 1 1 auto; }

        .auth-captcha-img {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            border: 1px solid var(--sipila-line);
            border-radius: 0.6rem;
            overflow: hidden;
            background: var(--sipila-soft);
            padding: 0.2rem;
        }

        .captcha-img {
            display: block;
            height: 42px;
            width: auto;
            user-select: none;
            border-radius: 0.4rem;
        }

        .captcha-refresh {
            flex: 0 0 auto;
            border: 1px solid var(--sipila-line);
            background: #fff;
            color: var(--sipila-muted);
            border-radius: 0.6rem;
            padding: 0 0.8rem;
            font-size: 1.05rem;
            cursor: pointer;
            transition: color 0.15s ease, border-color 0.15s ease;
        }

        .captcha-refresh:hover {
            color: var(--sipila-accent);
            border-color: var(--sipila-accent);
        }

        .auth-submit {
            width: 100%;
            margin-top: 0.7rem;
            padding: 0.72rem 1rem;
            font-weight: 600;
            border: 0;
            border-radius: 0.6rem;
            color: #fff;
            background: linear-gradient(135deg, var(--sipila-accent), var(--sipila-accent-2));
            box-shadow: 0 8px 18px var(--sipila-accent-shadow);
            transition: transform 0.06s ease, box-shadow 0.15s ease, filter 0.15s ease;
        }

        .auth-submit:hover { filter: brightness(1.05); }

        .auth-submit:active { transform: translateY(1px); box-shadow: 0 5px 12px var(--sipila-accent-shadow); }

        /* Alerts */
        .auth-alerts { margin-bottom: 0.5rem; }

        .auth-alerts .alert {
            border-radius: 0.6rem;
            padding: 0.6rem 0.85rem;
            font-size: 0.86rem;
            margin-bottom: 0.6rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .auth-alerts .alert i { font-size: 1rem; }

        .auth-alerts .btn-close { padding: 0.65rem 0.85rem; }

        /* Footer */
        .auth-footer {
            text-align: center;
            margin-top: 1.25rem;
            color: #94a3b8;
            font-size: 0.78rem;
        }

        .auth-footer .bi { color: var(--sipila-accent); }

        .auth-footer a {
            color: #94a3b8;
            text-decoration: none;
            border-bottom: 1px dotted #94a3b8;
        }

        .auth-footer a:hover { color: var(--sipila-accent); border-bottom-color: var(--sipila-accent); }

        @media (max-width: 480px) {
            .auth-card { padding: 1.6rem 1.25rem 1.25rem; border-radius: 1rem; }
        }
    </style>
    <script type="text/javascript" src="{{ url_for('static', filename='js/bootstrap.bundle.min.js') }}"></script>
    <script type="text/javascript" src="{{ url_for('static', filename='js/htmx.min.js') }}"></script>
</head>
<body hx-boost="true" hx-push-url="true" class="sipila-auth">

<div class="auth-wrap {{ 'auth-theme-admin' if request.endpoint == 'auth.login_admin' else 'auth-theme-siswa' }}">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-brand-badge"><i class="bi bi-laptop"></i></div>
            <h1>{{ app_name }}</h1>
            <p>SMKIT Ihsanul Fikri Mungkid</p>
        </div>

        {% set is_admin_page = request.endpoint == 'auth.login_admin' %}
        <div class="auth-role-toggle" role="group" aria-label="Pilih role">
            <a href="{{ url_for('auth.login_admin') }}"
               class="{{ 'active' if is_admin_page else '' }}">
                <i class="bi bi-person-gear"></i>Admin
            </a>
            <a href="{{ url_for('auth.login_siswa') }}"
               class="{{ 'active' if not is_admin_page else '' }}">
                <i class="bi bi-mortarboard"></i>Siswa
            </a>
        </div>

        {% if error %}
        <div class="auth-alerts">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ error }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
        {% endif %}
        {% if success %}
        <div class="auth-alerts">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ success }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
        {% endif %}
        {% if info %}
        <div class="auth-alerts">
            <div class="alert alert-primary alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <span>{{ info }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
        {% endif %}

        {% block content %} {% endblock %}

        <div class="auth-footer">
            <i class="bi bi-shield-lock"></i> Sistem Peminjaman Laptop
            &middot; <a hx-boost="False" href="{{ url_for('pantau.monitor') }}">Monitor Permintaan Hari Ini</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener('htmx:beforeRequest', function () {
        document.body.classList.add('dimmed');
    });
    document.addEventListener('htmx:afterRequest', function () {
        document.body.classList.remove('dimmed');
    });

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-pw-toggle]');
        if (!btn) return;
        var target = document.getElementById(btn.getAttribute('data-pw-toggle'));
        if (!target) return;
        var icon = btn.querySelector('i.bi');
        if (target.type === 'password') {
            target.type = 'text';
            if (icon) { icon.classList.remove('bi-eye'); icon.classList.add('bi-eye-slash'); }
            btn.setAttribute('aria-label', 'Sembunyikan password');
        } else {
            target.type = 'password';
            if (icon) { icon.classList.remove('bi-eye-slash'); icon.classList.add('bi-eye'); }
            btn.setAttribute('aria-label', 'Tampilkan password');
        }
        target.focus();
    });
</script>
</body>
</html>
